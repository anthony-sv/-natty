node_modules/
dist/
*.tsbuildinfo
.env
.env.local
*.local
.DS_Store
Thumbs.db
apps/*/src/routeTree.gen.ts
# Scratch files the TanStack Router plugin writes while code-splitting routes.
apps/*/.tanstack/
# Nitro's production build (server + prerendered SPA shell) and scratch dir.
apps/*/.output/
apps/*/.nitro/

# Agent skills are vendored in .agents/skills/; .claude/skills/ is only a
# mirror of it (a symlink on POSIX, a copy on Windows), so committing both
# would duplicate every file. settings.local.json is per-machine.
.claude/skills/
.claude/settings.local.json

# Private source reference material — attributed to a third party, not shipped in the app
gym-docs/

# Screenshots and report from the layout checks in apps/web/tools.
apps/*/.audit/

# Generated by tools/seed-backup.mjs — regenerate it rather than commit it.
apps/*/natty-seed.json

# Downloaded dataset and generated candidate list for tools/apply-exercise-media.mjs
# — re-fetch and re-run rather than commit; only the reviewed output (media.ts,
# public/exercises/) is checked in.
apps/*/tools/.cache/
