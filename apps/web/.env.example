# Copy to .env and fill in from the Supabase dashboard.

# Client-safe (VITE_ prefix = bundled into the browser JS, by design).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET — server-only (no VITE_ prefix, so Vite never bundles it).
# Supabase → Connect → "Transaction pooler" connection string (port 6543).
# Never commit a real value; rotate the DB password if it ever leaks.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
